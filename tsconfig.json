{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": "./",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@continuum/contracts": [
        "../packages/contracts/src/index.ts"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/contracts/**/*.ts",
    "packages/contracts/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/wpd/types/**/*.ts",
    ".next/wpd/dev/types/**/*.ts",
    ".next/studio-veo-refs-e2e/types/**/*.ts",
    ".next/studio-veo-refs-e2e/dev/types/**/*.ts",
    ".next/budget-probe/types/**/*.ts",
    ".next/budget-probe/dev/types/**/*.ts",
    ".next/prepush/types/**/*.ts",
    ".next/prepush/dev/types/**/*.ts",
    ".next-fdecomp/types/**/*.ts",
    ".next-fdecomp/dev/types/**/*.ts",
    ".next-gate/types/**/*.ts",
    ".next-gate/dev/types/**/*.ts",
    ".next/studio-veo-refs-e2e-f-palette/types/**/*.ts",
    ".next/studio-veo-refs-e2e-f-palette/dev/types/**/*.ts",
    ".next-t-techniques/types/**/*.ts",
    ".next-t-techniques/dev/types/**/*.ts",
    ".next-f-palette/types/**/*.ts",
    ".next-f-palette/dev/types/**/*.ts",
    ".next-f-runtime/types/**/*.ts",
    ".next-f-runtime/dev/types/**/*.ts",
    ".next-gate2/types/**/*.ts",
    ".next-gate2/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts",
    ".next-palette/types/**/*.ts",
    ".next-palette/dev/types/**/*.ts",
    ".next-subtitles/types/**/*.ts",
    ".next-subtitles/dev/types/**/*.ts",
    ".next-sweep/types/**/*.ts",
    ".next-sweep/dev/types/**/*.ts",
    ".next-technique/types/**/*.ts",
    ".next-technique/dev/types/**/*.ts",
    ".next-batch/types/**/*.ts",
    ".next-batch/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts",
    ".next-d01fix/types/**/*.ts",
    ".next-d01fix/dev/types/**/*.ts",
    ".next-palette-gate/types/**/*.ts",
    ".next-palette-gate/dev/types/**/*.ts",
    ".next-style-hover/types/**/*.ts",
    ".next-style-hover/dev/types/**/*.ts",
    ".next-palette-prov/types/**/*.ts",
    ".next-palette-prov/dev/types/**/*.ts",
    ".next-palette-gate2/types/**/*.ts",
    ".next-palette-gate2/dev/types/**/*.ts",
    ".next-palette-gate3/types/**/*.ts",
    ".next-palette-gate3/dev/types/**/*.ts",
    ".next-elements-onboard/types/**/*.ts",
    ".next-elements-onboard/dev/types/**/*.ts",
    ".next/studio-node-chrome-e2e/types/**/*.ts",
    ".next/studio-node-chrome-e2e/dev/types/**/*.ts",
    ".next-technique-gate/types/**/*.ts",
    ".next-technique-gate/dev/types/**/*.ts",
    ".next/admin-search-e2e/types/**/*.ts",
    ".next/admin-search-e2e/dev/types/**/*.ts",
    ".next/goals-orchestrator-e2e/types/**/*.ts",
    ".next/goals-orchestrator-e2e/dev/types/**/*.ts",
    ".next/studio-color-picker-e2e/types/**/*.ts",
    ".next/studio-color-picker-e2e/dev/types/**/*.ts",
    ".next/inspector-local/types/**/*.ts",
    ".next/inspector-local/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp/**",
    "e2e/**",
    "calendar/**",
    "supabase/functions/**",
    "tests/**",
    "**/*.bench.*",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
