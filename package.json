{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/contracts"
  ],
  "overrides": {
    "@radix-ui/react-primitive": "2.1.7"
  },
  "scripts": {
    "dev": "bun run --bun next dev --turbopack",
    "build": "bun run typecheck:build && next build --webpack && bun run bundle:check",
    "start": "next start",
    "lint": "cd .. && bun run agent:check -- --scope Continuum-Frontend",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:build": "tsc --noEmit --pretty false --project ${NEXT_TSCONFIG_PATH:-tsconfig.build.json}",
    "bundle:check": "bun scripts/check-vercel-bundle-budget.mjs",
    "test:vercel": "bun test scripts/check-vercel-bundle-budget.test.ts scripts/vercel-ignore-build.test.ts src/lib/theme/themeDom.test.ts",
    "vercel:runtime:bench": "playwright test --config playwright.vercel.config.ts",
    "tests": "bun test --path-ignore-patterns '**/e2e/**'",
    "test": "bun run tests",
    "test:e2e": "playwright test",
    "goals:orchestrator:e2e:bench": "set -a; . ./.env.local; set +a; GOALS_BENCH_BACKEND_PORT=4401 NEXT_PUBLIC_API_URL=http://127.0.0.1:4401 PORT=3108 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3108 NEXT_DIST_DIR=.next/goals-orchestrator-e2e playwright test e2e/goals-orchestrator.bench.spec.ts --workers=1",
    "optimizer:viz:bench": "bun run src/components/paid-media/optimizer/charts/optimizer-viz.bench.ts",
    "optimizer:e2e:bench": "playwright test --config playwright.optimizer.config.ts --workers=1",
    "organic:metrics:compare:bench": "bun run src/lib/organic/organic-metrics-compare.bench.ts",
    "posthog:logs:bench": "NODE_ENV=production bun run src/lib/observability/posthog-logs.bench.ts",
    "trends:render:e2e:bench": "bun run src/lib/brand-insights/trends-render.bench.ts",
    "organic:metrics:compare:e2e": "playwright test e2e/organic-metrics-compare.spec.ts",
    "organic:trends:header:e2e": "playwright test e2e/organic-trends-header-module.spec.ts",
    "library:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/library-poster-transcript.spec.ts e2e/library-range-comments-editor.spec.ts",
    "library:creative-operations:e2e:bench": "set -a; . ./.env.local; set +a; PORT=3104 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3104 NEXT_DIST_DIR=.next/library-creative-operations-e2e NEXT_TSCONFIG_PATH=tsconfig.e2e.json playwright test e2e/library-creative-operations.spec.ts --workers=1",
    "library:poster:select:e2e:bench": "set -a; . ./.env.local; set +a; PORT=3106 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3106 NEXT_DIST_DIR=.next/library-poster-select-e2e NEXT_TSCONFIG_PATH=tsconfig.e2e.json playwright test e2e/library-poster-select.spec.ts --workers=1",
    "supabase:gen:types": "node scripts/generate-supabase-types.mjs",
    "generate:types": "node scripts/generate-supabase-types.mjs",
    "generate:types:brand": "SUPABASE_SCHEMAS=brand_profiles node scripts/generate-supabase-types.mjs",
    "check-cache": "node scripts/check-cache.mjs",
    "cache:clear": "rm -rf .next/cache node_modules/.cache",
    "chat:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/chat-shell.spec.ts --workers=1",
    "login:password:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/login-password.spec.ts --workers=1",
    "tiktok:profile:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/tiktok-profile-header.spec.ts --workers=1",
    "planner:e2e:bench": "set -a; . ./.env.local; set +a; NEXT_DIST_DIR=.next/e2e NEXT_TSCONFIG_PATH=tsconfig.e2e.json PLAYWRIGHT_BASE_URL=http://localhost:3002 playwright test e2e/organic-planner-chat.spec.ts --workers=1",
    "projection:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/mid-run-projection.spec.ts --workers=1",
    "skills:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/skills-composer.spec.ts --workers=1",
    "studio:starter:bench": "bun run e2e/studio-starter.bench.ts",
    "prompts:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/prompt-library.spec.ts --workers=1",
    "agent:runs:bench": "set -a; . ./.env.local; set +a; bun run e2e/agent-runs.bench.ts",
    "ai-studio:image:bench": "set -a; . ./.env.local; set +a; bun run e2e/ai-studio-image.bench.ts",
    "ai-studio:sniper:e2e:bench": "set -a; . ./.env.local; set +a; bun run e2e/ai-studio-image.bench.ts",
    "jaina:runs:bench": "set -a; . ./.env.local; set +a; bun run e2e/jaina-runs.bench.ts",
    "videoeditor:e2e:bench": "playwright test e2e/video-editor-playback.spec.ts --workers=1",
    "planner:status:e2e:bench": "set -a; . ./.env.local; set +a; playwright test e2e/organic-planner-status.spec.ts --workers=1",
    "changelog:e2e:bench": "bun test src/components/changelog/WhatsNewBell.bench.test.tsx"
  },
