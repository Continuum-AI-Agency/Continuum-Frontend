# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Every ad-hoc dist dir a bench or gate mints (.next-gate, .next-shell-review-*).
# Not just repo hygiene: Tailwind v4 auto source detection scans anything git does not
# ignore, and a Turbopack .sst cache is binary — it yields garbage class candidates like
# `var(--app-$\x00-h)` that fail CSS parsing and 500 EVERY route.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.ralph-state/history.json
.ralph-state/state.json

calendar/

# local agent/tooling directories
/.agent/
/.agents/
/.claude/
/.codebuddy/
/.commandcode/
/.continue/
/.crush/
/.cursor/
/.factory/
/.goose/
/.junie/
/.kilocode/
/.kiro/
/.kode/
/.mcpjam/
/.mux/
/.neovate/
/.next/
/.openhands/
/.pi/
/.pochi/
/.qoder/
/.qwen/
/.ralph-state/
/.roo/
/.sisyphus/
/.trae/
/.vercel/
/.windsurf/
/.worktrees/
.omc/
.env.local

# Nutrient viewer assets copied from node_modules at dev/build time
/public/nutrient-viewer/

# Playwright E2E run artifacts (see e2e/README.md)
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Generated shell-review and E2E Next.js worktrees must not be Tailwind sources.
/tmp/continuum-next-e2e-shell/
